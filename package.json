{
  "name": "bettersantamaria-web",
  "version": "1.0.0",
  "description": "BetterSantaMaria.org - Civic Portal for LGU Santa Maria, Bulacan",
  "scripts": {
    "dev": "python serve.py --port 8000 --directory .",
    "admin": "node scripts/admin-server.mjs",
    "build": "bash build.sh",
    "build:major": "bash scripts/version.sh major && bash build.sh --no-bump",
    "build:minor": "bash scripts/version.sh minor && bash build.sh --no-bump",
    "serve": "python serve.py --port 8000 --directory .",
    "serve:dist": "python serve.py --port 8080 --directory dist",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh"
  },
  "keywords": [
    "santa-maria",
    "bulacan",
    "government",
    "lgu",
    "civic-tech"
  ],
  "author": "Josiah Jezrael Guevarra",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  }
}
